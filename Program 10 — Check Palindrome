#include <stdio.h>

int main()
{
    char str[100];
    int left = 0, right, palindrome = 1;

    printf("Enter a string: ");
    scanf("%99s", str);

    for(right = 0; str[right] != '\0'; right++)
        ;

    right--;

    while(left < right)
    {
        if(str[left] != str[right])
        {
            palindrome = 0;
            break;
        }

        left++;
        right--;
    }

    if(palindrome)
        printf("Palindrome");
    else
        printf("Not a palindrome");

    return 0;
}
#include <stdio.h>

int findMinimum(int arr[], int n)
{
    int min = arr[0];

    for(int i = 1; i < n; i++)
    {
        if(arr[i] < min)
        {
            min = arr[i];
        }
    }

    return min;
}

int main()
{
    int arr[5] = {40, 10, 50, 20, 30};

    printf("Minimum = %d", findMinimum(arr, 5));

    return 0;
}
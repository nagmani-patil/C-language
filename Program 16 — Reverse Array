#include <stdio.h>

void reverseArray(int arr[], int n)
{
    int start = 0;
    int end = n - 1;
    int temp;

    while(start < end)
    {
        temp = arr[start];
        arr[start] = arr[end];
        arr[end] = temp;

        start++;
        end--;
    }
}

int main()
{
    int arr[5] = {10, 20, 30, 40, 50};

    reverseArray(arr, 5);

    for(int i = 0; i < 5; i++)
    {
        printf("%d ", arr[i]);
    }

    return 0;
}
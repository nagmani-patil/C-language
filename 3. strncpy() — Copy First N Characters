#include <stdio.h>
#include <string.h>

int main()
{
    char source[100];
    char destination[100];

    printf("Enter a string: ");
    fgets(source, sizeof(source), stdin);

    source[strcspn(source, "\n")] = '\0';

    strncpy(destination, source, 5);
    destination[5] = '\0';

    printf("Copied first 5 characters: %s\n", destination);

    return 0;
}
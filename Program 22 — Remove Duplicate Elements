#include <stdio.h>

void removeDuplicates(int arr[], int *n)
{
    for(int i = 0; i < *n; i++)
    {
        for(int j = i + 1; j < *n; j++)
        {
            if(arr[i] == arr[j])
            {
                for(int k = j; k < *n - 1; k++)
                {
                    arr[k] = arr[k + 1];
                }

                (*n)--;
                j--;
            }
        }
    }
}

int main()
{
    int arr[10] = {10, 20, 10, 30, 20, 40};
    int n = 6;

    removeDuplicates(arr, &n);

    printf("Array after removing duplicates: ");

    for(int i = 0; i < n; i++)
    {
        printf("%d ", arr[i]);
    }

    return 0;
}
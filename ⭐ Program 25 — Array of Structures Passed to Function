#include <stdio.h>

struct Student
{
    int rollNo;
    char name[30];
    float marks;
};

void display(struct Student s[], int n)
{
    for(int i = 0; i < n; i++)
    {
        printf("Roll No: %d\n", s[i].rollNo);
        printf("Name: %s\n", s[i].name);
        printf("Marks: %.2f\n\n", s[i].marks);
    }
}

int main()
{
    struct Student s[2] =
    {
        {1, "Amit", 85.5},
        {2, "Neha", 90.0}
    };

    display(s, 2);

    return 0;
}
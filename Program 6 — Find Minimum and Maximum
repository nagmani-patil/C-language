#include <stdio.h>

void findMinMax(int arr[], int n)
{
    int min = arr[0];
    int max = arr[0];

    for(int i = 1; i < n; i++)
    {
        if(arr[i] < min)
            min = arr[i];

        if(arr[i] > max)
            max = arr[i];
    }

    printf("Minimum = %d\n", min);
    printf("Maximum = %d\n", max);
}

int main()
{
    int arr[5] = {20, 5, 40, 10, 30};

    findMinMax(arr, 5);

    return 0;
}
#include <stdio.h>

int isPrime(int num)
{
    if(num < 2)
        return 0;

    for(int i = 2; i * i <= num; i++)
    {
        if(num % i == 0)
            return 0;
    }

    return 1;
}

void printPrime(int arr[], int n)
{
    for(int i = 0; i < n; i++)
    {
        if(isPrime(arr[i]))
            printf("%d ", arr[i]);
    }
}

int main()
{
    int arr[6] = {10, 11, 15, 17, 20, 23};

    printPrime(arr, 6);

    return 0;
}
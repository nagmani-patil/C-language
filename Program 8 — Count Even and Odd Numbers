#include <stdio.h>

void countEvenOdd(int arr[], int n)
{
    int even = 0;
    int odd = 0;

    for(int i = 0; i < n; i++)
    {
        if(arr[i] % 2 == 0)
            even++;
        else
            odd++;
    }

    printf("Even = %d\n", even);
    printf("Odd = %d\n", odd);
}

int main()
{
    int arr[6] = {10, 15, 22, 31, 40, 7};

    countEvenOdd(arr, 6);

    return 0;
}
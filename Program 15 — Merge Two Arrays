#include <stdio.h>

void mergeArrays(int a[], int b[], int result[],
                 int n1, int n2)
{
    int k = 0;

    for(int i = 0; i < n1; i++)
    {
        result[k++] = a[i];
    }

    for(int i = 0; i < n2; i++)
    {
        result[k++] = b[i];
    }
}

int main()
{
    int a[3] = {1, 2, 3};
    int b[3] = {4, 5, 6};
    int result[6];

    mergeArrays(a, b, result, 3, 3);

    for(int i = 0; i < 6; i++)
    {
        printf("%d ", result[i]);
    }

    return 0;
}
#include <stdio.h>

int mystrlen(char str[])
{
    int i = 0;

    while (str[i] != '\0')
    {
        i++;
    }

    return i;
}

int main()
{
    char str[100];
    int length;

    printf("Enter a string: ");
    scanf("%99s", str);

    length = mystrlen(str);

    printf("Length of string = %d", length);

    return 0;
}
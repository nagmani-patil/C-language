#include <stdio.h>
#include <stdlib.h>

int findSum(int *arr, int n)
{
    int i;
    int sum = 0;

    for(i = 0; i < n; i++)
    {
        sum = sum + arr[i];
    }

    return sum;
}

int main()
{
    int *arr;
    int n, i;
    int sum;

    printf("Enter size of array: ");
    scanf("%d", &n);

    arr = (int *)malloc(n * sizeof(int));

    if(arr == NULL)
    {
        printf("Memory Allocation Failed");
        return 0;
    }

    printf("Enter %d elements:\n", n);

    for(i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    sum = findSum(arr, n);

    printf("Sum of all elements = %d", sum);

    free(arr);

    return 0;
}

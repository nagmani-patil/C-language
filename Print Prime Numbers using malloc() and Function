#include <stdio.h>
#include <stdlib.h>

void printPrime(int *arr, int n)
{
    int i, j, prime;

    printf("\nPrime Numbers are:\n");

    for(i = 0; i < n; i++)
    {
        prime = 1;

        if(arr[i] <= 1)
        {
            prime = 0;
        }

        for(j = 2; j < arr[i]; j++)
        {
            if(arr[i] % j == 0)
            {
                prime = 0;
                break;
            }
        }

        if(prime == 1)
        {
            printf("%d ", arr[i]);
        }
    }
}

int main()
{
    int *arr;
    int n, i;

    printf("Enter size of array: ");
    scanf("%d", &n);

    arr = (int *)malloc(n * sizeof(int));

    if(arr == NULL)
    {
        printf("Memory Allocation Failed");
        return 0;
    }

    printf("Enter %d elements:\n", n);

    for(i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    printPrime(arr, n);

    free(arr);

    return 0;
}

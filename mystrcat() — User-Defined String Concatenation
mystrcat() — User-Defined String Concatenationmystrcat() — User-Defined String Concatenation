#include <stdio.h>

void mystrcat(char str1[], char str2[])
{
    int i = 0;
    int j = 0;

    // Find end of str1
    while (str1[i] != '\0')
    {
        i++;
    }

    // Copy str2 at the end of str1
    while (str2[j] != '\0')
    {
        str1[i] = str2[j];
        i++;
        j++;
    }

    // Add null character
    str1[i] = '\0';
}

int main()
{
    char str1[200], str2[100];

    printf("Enter first string: ");
    scanf("%99s", str1);

    printf("Enter second string: ");
    scanf("%99s", str2);

    mystrcat(str1, str2);

    printf("Concatenated string = %s", str1);

    return 0;
}
#include <stdio.h>
#include <stdlib.h>

void addArray(int *arr1, int *arr2, int *arr3, int n)
{
    int i;

    for(i = 0; i < n; i++)
    {
        arr3[i] = arr1[i] + arr2[i];
    }

    printf("\nAddition of Two Arrays:\n");

    for(i = 0; i < n; i++)
    {
        printf("%d ", arr3[i]);
    }
}

int main()
{
    int *arr1, *arr2, *arr3;
    int n, i;

    printf("Enter size of array: ");
    scanf("%d", &n);

    arr1 = (int *)malloc(n * sizeof(int));
    arr2 = (int *)malloc(n * sizeof(int));
    arr3 = (int *)malloc(n * sizeof(int));

    if(arr1 == NULL || arr2 == NULL || arr3 == NULL)
    {
        printf("Memory Allocation Failed");
        return 0;
    }

    printf("\nEnter elements of First Array:\n");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &arr1[i]);
    }

    printf("\nEnter elements of Second Array:\n");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &arr2[i]);
    }

    addArray(arr1, arr2, arr3, n);

    free(arr1);
    free(arr2);
    free(arr3);

    return 0;
}

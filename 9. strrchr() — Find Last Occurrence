#include <stdio.h>
#include <string.h>

int main()
{
    char str[100];
    char ch;

    printf("Enter a string: ");
    fgets(str, sizeof(str), stdin);

    str[strcspn(str, "\n")] = '\0';

    printf("Enter character: ");
    scanf(" %c", &ch);

    char *result = strrchr(str, ch);

    if(result != NULL)
        printf("Last occurrence at position %ld\n",
               result - str + 1);
    else
        printf("Character not found\n");

    return 0;
}
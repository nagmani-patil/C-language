#include <stdio.h>

int main()
{
    char str[100];
    int index, i;

    printf("Enter a string: ");
    scanf("%99s", str);

    printf("Enter index to remove: ");
    scanf("%d", &index);

    for(i = index; str[i] != '\0'; i++)
    {
        str[i] = str[i + 1];
    }

    printf("Result: %s", str);

    return 0;
}
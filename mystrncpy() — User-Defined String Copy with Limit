#include <stdio.h>

void mystrncpy(char dest[], char src[], int n)
{
    int i = 0;

    while (i < n && src[i] != '\0')
    {
        dest[i] = src[i];
        i++;
    }

    dest[i] = '\0';
}

int main()
{
    char src[100], dest[100];
    int n;

    printf("Enter source string: ");
    scanf("%99s", src);

    printf("Enter number of characters: ");
    scanf("%d", &n);

    mystrncpy(dest, src, n);

    printf("Copied string = %s", dest);

    return 0;
}
#include <stdio.h>

int countOccurrence(int arr[], int n, int key)
{
    int count = 0;

    for(int i = 0; i < n; i++)
    {
        if(arr[i] == key)
            count++;
    }

    return count;
}

int main()
{
    int arr[6] = {10, 20, 10, 30, 10, 40};

    printf("Occurrence = %d",
           countOccurrence(arr, 6, 10));

    return 0;
}
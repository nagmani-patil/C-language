#include <stdio.h>

void addArrays(int a[], int b[], int result[], int n)
{
    for(int i = 0; i < n; i++)
    {
        result[i] = a[i] + b[i];
    }
}

int main()
{
    int a[3] = {10, 20, 30};
    int b[3] = {1, 2, 3};
    int result[3];

    addArrays(a, b, result, 3);

    printf("Result: ");

    for(int i = 0; i < 3; i++)
    {
        printf("%d ", result[i]);
    }

    return 0;
}
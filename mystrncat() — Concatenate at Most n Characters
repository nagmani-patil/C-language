#include <stdio.h>

void mystrncat(char str1[], char str2[], int n)
{
    int i = 0;
    int j = 0;

    // Find the end of str1
    while (str1[i] != '\0')
    {
        i++;
    }

    // Copy at most n characters from str2
    while (str2[j] != '\0' && j < n)
    {
        str1[i] = str2[j];
        i++;
        j++;
    }

    // Add null character
    str1[i] = '\0';
}

int main()
{
    char str1[200], str2[100];
    int n;

    printf("Enter first string: ");
    scanf("%99s", str1);

    printf("Enter second string: ");
    scanf("%99s", str2);

    printf("Enter number of characters: ");
    scanf("%d", &n);

    mystrncat(str1, str2, n);

    printf("Concatenated string = %s", str1);

    return 0;
}
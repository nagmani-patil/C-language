#include <stdio.h>

void printOddEven(int arr[], int n)
{
    printf("Even numbers: ");

    for(int i = 0; i < n; i++)
    {
        if(arr[i] % 2 == 0)
            printf("%d ", arr[i]);
    }

    printf("\nOdd numbers: ");

    for(int i = 0; i < n; i++)
    {
        if(arr[i] % 2 != 0)
            printf("%d ", arr[i]);
    }
}

int main()
{
    int arr[6] = {10, 15, 22, 31, 40, 7};

    printOddEven(arr, 6);

    return 0;
}